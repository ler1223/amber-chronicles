 "chapters": [
  {
   "id": "swamp",
   "name": "Глава 1. Болото",
   "expeditions": [
    {
     "id": "prologue",
     "name": "Пролог: тропа через топь",
     "intro": [
      {
       "who": "narrator",
       "text": "Янтарь — застывший свет древних. Пока он горит в маяках, Гниль не выходит из болот."
      },
      {
       "who": "narrator",
       "text": "Этой осенью маяки гаснут один за другим. Кто-то крадёт янтарь."
      },
      {
       "who": "mage",
       "text": "Ирма, ученица хранителей. Мне велено донести свечу до Янтарного маяка за топью."
      },
      {
       "who": "warrior",
       "text": "Торвальд. Наёмник. Мне велено, чтобы ученица дошла живой. Держись за моей спиной."
      },
      {
       "who": "mage",
       "text": "За спиной у меня огонь, Торвальд. Посмотрим, кто кого будет прикрывать."
      }
     ],
     "battles": [
      {
       "encounter": "st_edge",
       "tutorial": [
        {
         "text": "Расстановка: перетащите героев мышью в зелёной зоне. Пробел или кнопка «В бой» — начать.",
         "until": "start"
        },
        {
         "text": "Бой начинается на паузе: время стоит, можно спокойно отдавать приказы. Пробел ставит и снимает паузу. Нажмите Пробел, чтобы продолжить.",
         "until": "ack"
        },
        {
         "text": "Выберите Торвальда — клик левой кнопкой по фигурке (или клавиша 1).",
         "until": "select:warrior",
         "pause": true
        },
        {
         "text": "Правый клик по клетке — идти туда. Правый клик по врагу — атаковать его. Отправьте Торвальда к слизням.",
         "until": "order",
         "pause": true
        },
        {
         "text": "Снимите паузу (Пробел) — герои выполнят приказы. Ирма атакует издалека сама.",
         "until": "unpause"
        },
        {
         "text": "Победите обоих слизней.",
         "until": "win"
        }
       ]
      },
      {
       "encounter": "st_causeway",
       "intro": [
        {
         "who": "mage",
         "text": "Видишь бочку у них за спиной? Это масло. Масло любит огонь."
        },
        {
         "who": "warrior",
         "text": "Только не подожги меня."
        }
       ],
       "tutorial": [
        {
         "text": "Навыки открываются с уровнем героя. Сейчас у Ирмы есть Огненный шар (Q); остальные появятся позже. Навыки тратят AP — синие пипсы под героем.",
         "until": "start"
        },
        {
         "text": "Выберите Ирму и нажмите Q — Огненный шар. Потом укажите клетку рядом с бочкой.",
         "until": "skill:fireball",
         "pause": true
        },
        {
         "text": "Огонь остаётся на клетках и жжёт тех, кто в нём стоит. Масло в огне взрывается. Не стойте в огне сами!",
         "until": "time:4"
        },
        {
         "text": "Победите слизней.",
         "until": "win"
        }
       ]
      },
      {
       "encounter": "st_frogs",
       "tutorial": [
        {
         "text": "У Торвальда пока один навык — Мощный удар (Q). Провокация откроется на 2 уровне. Используйте Мощный удар, чтобы пробить жаб.",
         "until": "skill:power_strike",
         "pause": true
        },
        {
         "text": "Ctrl + клавиша навыка включает автокаст: навык применяется сам. Настройки сохраняются между вылазками. Пробел — понятно.",
         "until": "ack"
        },
        {
         "text": "Лучник жаб стоит далеко — доберитесь до него.",
         "until": "win"
        }
       ]
      }
     ],
     "outro": [
      {
       "who": "warrior",
       "text": "Для ученицы ты неплохо жжёшь."
      },
      {
       "who": "mage",
       "text": "А ты для наёмника неплохо стоишь. Впереди часовня — там должен быть огонь в окнах. Его нет."
      }
     ],
     "level": 1
    },
    {
     "id": "chapel",
     "name": "Огни в тумане",
     "join": "priest",
     "intro": [
      {
       "who": "priest",
       "text": "Сюда! Они лезут из воды, а у меня только молитвы и ведро святой воды!"
      },
      {
       "who": "warrior",
       "text": "Молитвы — это тоже оружие, отец?"
      },
      {
       "who": "priest",
       "text": "Брат. Брат Осмунд. И да — если правильно ими бить."
      }
     ],
     "battles": [
      {
       "encounter": "st_chapel",
       "tutorial": [
        {
         "text": "Брат Осмунд присоединился! Жрец лечит: Обет (Q) — лечение союзника, срабатывает, когда тот ранен.",
         "until": "start"
        },
        {
         "text": "Святая вода (W) лечит своих, очищает и тушит огонь — и не жжёт союзников. Попробуйте Святую воду.",
         "until": "skill:holy_water",
         "pause": true
        },
        {
         "text": "Теги стихий взаимодействуют: огонь + вода = пар, масло + огонь = вспышка. Ищите сочетания! Пробел — понятно.",
         "until": "ack"
        },
        {
         "text": "Отбейте часовню.",
         "until": "win"
        }
       ]
      },
      {
       "encounter": "reeds"
      },
      {
       "encounter": "mill_guard"
      }
     ],
     "outro": [
      {
       "who": "priest",
       "text": "Янтарь из часовни украли этой ночью. Следы ведут в камыши — к логову ведьмы."
      },
      {
       "who": "mage",
       "text": "Тогда и нам туда."
      }
     ],
     "level": 1
    },
    {
     "id": "reeds",
     "name": "Камышовая засада",
     "join": "archer",
     "intro": [
      {
       "who": "archer",
       "text": "Ни шагу! В камышах засада — я третий день считаю их лучников."
      },
      {
       "who": "warrior",
       "text": "И сколько насчитала?"
      },
      {
       "who": "archer",
       "text": "Достаточно, чтобы мне был нужен кто-то, кто примет стрелы на щит. Я Лина."
      }
     ],
     "battles": [
      {
       "encounter": "st_reedbed",
       "tutorial": [
        {
         "text": "Лина присоединилась! Лучник бьёт издалека. Прицельный выстрел (Q) — мощный, лучше по неподвижной цели.",
         "until": "start"
        },
        {
         "text": "Камни (#) — укрытие: за ним урон по герою меньше. Держите Лину за камнем, а Торвальда — впереди.",
         "until": "order",
         "pause": true
        },
        {
         "text": "Дозор (E) — Лина стреляет по любому, кто войдёт в зону. Поставьте дозор на пути врагов.",
         "until": "skill:overwatch",
         "pause": true
        },
        {
         "text": "Победите засаду.",
         "until": "win"
        }
       ]
      },
      {
       "encounter": "camp"
      },
      {
       "encounter": "reeds_guard"
      }
     ],
     "outro": [
      {
       "who": "archer",
       "text": "Ведьма держит в гнезде всё, что украла. И жуков — больше, чем стрел у меня в колчане."
      }
     ],
     "level": 2
    },
    {
     "id": "nest",
     "name": "Сердце болота",
     "join": "guardian",
     "intro": [
      {
       "who": "guardian",
       "text": "Стой. Дальше — гнездо. Я сторожу этот брод десять лет, и ни один жук не прошёл."
      },
      {
       "who": "mage",
       "text": "Нам нужно пройти. Там янтарь всех маяков."
      },
      {
       "who": "guardian",
       "text": "Гарм. Значит, пройдём вместе. Мой щит — ваш."
      }
     ],
     "battles": [
